# Production environment for the Paisa VPS.
# Copy to <checkout>/paisa.env, fill in, then: chmod 600 and chown paisa:paisa.
# It is gitignored, so it is never committed.
# Both systemd services and the deploy script read this file.

# --- Core ---
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
# Apache is the only proxy in front of the API, so trust exactly one hop.
# Without this, rate limiting sees every request as coming from Apache itself.
TRUST_PROXY_HOPS=1

# --- Database (MySQL already on this box) ---
# Percent-encode any special characters in the password (@ becomes %40).
DATABASE_URL=mysql://paisa:CHANGE_ME@127.0.0.1:3306/paisa

# --- Authentication (required: production refuses to start without it) ---
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
# App Check is optional. Leave APP_CHECK_MODE=off

# Off by default. When on, a Firebase identity nobody has invited gets its own
# workspace with its own books and categories on first sign-in - a separate
# household that no existing user can see.
#
# Turn this on ONLY after disabling public sign-up in the Firebase console
# (Authentication -> Settings -> User actions -> uncheck "Enable create"), or
# anyone who finds the web API key can register themselves a household. That
# setting is the only control here: a console-created account is not
# email-verified, so provisioning deliberately does not require verification.
TENANT_SELF_PROVISION=false until you register a reCAPTCHA
# site key; set it to enforce and fill the two values below to turn it on.
APP_CHECK_MODE=off

# Off by default. When on, a Firebase identity nobody has invited gets its own
# workspace with its own books and categories on first sign-in - a separate
# household that no existing user can see.
#
# Turn this on ONLY after disabling public sign-up in the Firebase console
# (Authentication -> Settings -> User actions -> uncheck "Enable create"), or
# anyone who finds the web API key can register themselves a household. That
# setting is the only control here: a console-created account is not
# email-verified, so provisioning deliberately does not require verification.
TENANT_SELF_PROVISION=false
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_IDS=

# --- Dashboard origin ---
# Same-origin deployment: Apache serves the dashboard and proxies /v1 to the API,
# so this is the one public URL. Keep it protocol-exact and without a trailing slash.
CORS_ORIGINS=https://paisa.example.com

# --- Dashboard build-time values ---
# Vite inlines every NEXT_PUBLIC_* value when the dashboard is BUILT, not when it
# runs. deploy.sh sources this file before building, so changing any of these
# requires a rebuild (./deploy/deploy.sh), not just a restart.
NEXT_PUBLIC_API_URL=https://paisa.example.com
NEXT_PUBLIC_AUTH_MODE=firebase
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# --- Seed identities (only needed once, for the first run of `npm run seed`) ---
SEED_OWNER_FIREBASE_UID=
SEED_OWNER_EMAIL=
SEED_SPOUSE_FIREBASE_UID=
SEED_SPOUSE_EMAIL=
SEED_CA_FIREBASE_UID=
SEED_CA_EMAIL=

# --- Not required yet ---
# The worker receives no jobs (nothing enqueues them) and no code uploads to
# object storage, so REDIS_URL and the OBJECT_STORAGE_* values can stay empty
# until those features are actually built.
