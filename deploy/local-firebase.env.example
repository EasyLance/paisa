# Verify your Firebase project on your Mac before deploying anything.
#
# This runs the real Firebase sign-in against the in-memory store, so no MySQL is
# involved and nothing here touches production. Copy to .env.firebase-local
# (gitignored), fill in, then follow docs/DEPLOY_VPS.md "Verify Firebase locally".

# --- From Firebase console > Project settings > General ---
# Use the Project ID, NOT the display name you typed when creating the project.
# A project shown as "Paisa-Easylance" usually has an ID like paisa-easylance-4f21c.
FIREBASE_PROJECT_ID=

# --- From the same page, "Your apps" > Web app > SDK setup and configuration ---
# These are public values, embedded in every client bundle by design. They identify
# the project; they do not authorise anything on their own.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- From Authentication > Users, after you add yourself ---
# Copy the User UID column for the account you created.
SEED_OWNER_FIREBASE_UID=
SEED_OWNER_EMAIL=

# --- Fixed for this local test ---
AUTH_MODE=firebase
APP_CHECK_MODE=off
NEXT_PUBLIC_AUTH_MODE=firebase
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000
PORT=4000
# Deliberately no DATABASE_URL: the API falls back to the in-memory store.
